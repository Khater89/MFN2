# Local development. Production requires a unique secret and HTTPS.
DJANGO_DEBUG=1
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1
DJANGO_CSRF_TRUSTED_ORIGINS=
MARKETPLACE_TIME_ZONE=Asia/Amman
# DJANGO_SECRET_KEY=generate-and-store-securely
# DATABASE_PATH=/absolute/path/to/db.sqlite3
# Enable only for a trusted HTTPS reverse proxy that strips spoofed headers.
TRUST_HTTPS_PROXY=0
